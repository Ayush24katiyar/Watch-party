# Docker build context exclusions (backend image, Phase 9 Dockerfile).
# Keep: src/, migrations/, alembic.ini, pyproject.toml, uv.lock, README.md.

# VCS / Python noise
.git
.gitignore
__pycache__
*.py[oc]
.venv

# Secrets and config that never belong in an image
.env
.env.*
!.env.example

# The client is built and served as a static site, not part of the backend image
client

# Caches, caches, logs
.pytest_cache
.mypy_cache
.ruff_cache
dist
build
*.egg-info
*.log

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini

# Test suite, reports, and dev tooling (never part of the image)
tests
audit
scripts
.coverage

# Dev-only docs (keep README.md, .env.example)
ARCHITECTURE (1).md
AFTER_PHASE_4.md
CODE_AUDIT_AGENT.md
PRODUCTION.md
REWRITE_TESTS.md
TEST_ISSUES_DEEP_REPORT.md

# Local-only runtime files
.python-version
docker-compose.yml
