# Copy to .env and fill in for your environment.
# Postgres credentials/port must match your docker-compose.yml.
# Hosts like Render give postgres://... ; convert to postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://watch:watch@127.0.0.1:5432/watchparty

# Exact client URL(s), scheme + host, NO trailing slash. Comma-separated.
# Local:   http://localhost:5173
# Render:  https://watch-party-rosy-pi.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# If false (production), a missing Origin header is rejected before accept.
# true is local-only, for debuggers that cannot send an Origin header.
ALLOW_MISSING_ORIGIN=true

# Exposes /debug endpoints: live rooms, sockets, recent event buffer.
# true locally; MUST be false in production (leaks room codes and user ids).
DEBUG_ENDPOINTS=true